#
# cascade-pull.service — Ecosystem-wide git pull via wateringHole
#
# Works on any gate — auto-detects ECOPRIMALS_ROOT and gate identity.
#
# Install per-user (desktop gates):
#   mkdir -p ~/.config/systemd/user
#   cp cascade-pull.service cascade-pull.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now cascade-pull.timer
#
# Install system-wide (VPS / headless gates):
#   cp cascade-pull.service cascade-pull.timer /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now cascade-pull.timer
#
# Environment overrides:
#   Create the env file for your gate with any of:
#     ECOPRIMALS_ROOT=/opt/ecoPrimals
#     CASCADE_GATE=golgiBody
#     CASCADE_SOURCE=origin
#     CASCADE_PARALLEL=4

[Unit]
Description=Cascade pull — ecosystem workspace sync via wateringHole
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

EnvironmentFile=-%h/.config/cascade-pull.env
EnvironmentFile=-/etc/cascade-pull.env

ExecStart=/bin/bash -c '${ECOPRIMALS_ROOT:-/opt/ecoPrimals}/infra/wateringHole/scripts/cascade-pull.sh --gate ${CASCADE_GATE:-auto} --source ${CASCADE_SOURCE:-origin} --parallel ${CASCADE_PARALLEL:-1}'

StandardOutput=journal
StandardError=journal
TimeoutStartSec=600

[Install]
WantedBy=default.target
