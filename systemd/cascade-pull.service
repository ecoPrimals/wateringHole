#
# cascade-pull.service — Ecosystem-wide temporal cascade via membrane
#
# Works on any gate — auto-detects gate identity from ecosystem_manifest.toml.
# Supersedes the bash cascade-pull.sh (fossilized Wave 66).
#
# Install per-user (desktop gates):
#   mkdir -p ~/.config/systemd/user
#   cp cascade-pull.service cascade-pull.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now cascade-pull.timer
#
# Install system-wide (VPS / headless gates):
#   cp cascade-pull.service cascade-pull.timer /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now cascade-pull.timer
#
# Environment overrides:
#   Create the env file for your gate with any of:
#     MEMBRANE_BIN=/usr/local/bin/membrane
#     ECOPRIMALS_ROOT=/opt/ecoPrimals

[Unit]
Description=Temporal cascade — ecosystem workspace sync via membrane
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

EnvironmentFile=-%h/.config/cascade-pull.env
EnvironmentFile=-/etc/cascade-pull.env

ExecStart=${MEMBRANE_BIN:-/usr/local/bin/membrane} temporal.cascade

StandardOutput=journal
StandardError=journal
TimeoutStartSec=600

[Install]
WantedBy=default.target
