#
# cascade-pull.timer — Periodic ecosystem sync
#
# Default: every 4 hours. Adjust OnCalendar for gate-specific cadence.
# Randomized delay prevents all gates pulling simultaneously.
#
# Install:
#   cp cascade-pull.service cascade-pull.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now cascade-pull.timer
#
# Check status:
#   systemctl --user status cascade-pull.timer
#   journalctl --user -u cascade-pull.service --since today

[Unit]
Description=Cascade pull timer — ecosystem workspace sync

[Timer]
OnCalendar=*-*-* 00/4:00:00
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
