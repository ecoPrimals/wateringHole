# ──────────────────────────────────────────────────────────────
# ARCHITECTURE: GOLGIBODY DIDERM + GRAPHENEGATE TRUST MODEL
# ──────────────────────────────────────────────────────────────

[architecture.golgibody]
summary = """
The golgiBody diderm has two membrane faces and a peptidoglycan layer between them.
The WAN mesh requires formalizing the outer membrane face:

  INNER MEMBRANE (golgiBody)
    - Faces LAN / covalent bonded gates
    - Serves depot binaries to eastGate, strandGate, ironGate
    - Syncs source via cascade (peptidoglycan relay to Forgejo)
    - Trust: SSH keys, Forgejo HMAC, covalent bond auth
    - Current: VPS at 137.184.197.151 (operational)

  PEPTIDOGLYCAN LAYER
    - Build substrate between inner and outer membranes
    - Compiles static binaries (musl-static, cross-arch) from synced source
    - Stores depot in plasmidBin. SSH trust established (Wave 92).
    - Operational for x86_64-musl. aarch64 blocked on bearDog.

  OUTER MEMBRANE (golgiBody-ext)
    - Faces WAN / external / ionic+weak interaction partners
    - Serves depot to flockGate and future WAN gates
    - NEEDED: HTTP endpoint (Caddy /depot/) or separate instance
    - Trust: BTSP tokens, TLS, beardog capability verification

The inner membrane syncs the pepti layer. The pepti layer builds. Both membrane
faces serve from the pepti layer's output. Inner serves LAN (covalent). Outer
serves WAN (ionic/weak). The pepti layer is the air gap.
"""

[architecture.graphenegate]
summary = """
grapheneGate (Pixel 8) is the portable physical root of trust:
  - Titan M2 secure element binds FAMILY_SEED to hardware
  - BirdSong beacon proves family membership on any network
  - Can bootstrap new gates via USB or WiFi (Role 2-3)
  - Appears as standard Android device under scrutiny
  - Wave 105b: FIRST DEPLOYMENT — 6 primals running via aarch64-musl over ADB
    bearDog BTSP production, songbird federation, rhizocrypt, loamspine, sweetgrass, squirrel
  - NDK (aarch64-linux-android) blocked on bearDog StrongBox (future phase for APK/HSM)
See GRAPHENEGATE_BOOTSTRAP_STANDARD.md for full trust model.
"""

# ──────────────────────────────────────────────────────────────
# AAR: CHECKSUM MULTI-TARGET OVERWRITE (Wave 105)
# ──────────────────────────────────────────────────────────────

[aar.checksum_multi_target_overwrite]
problem = """aarch64 sweep (commit c46cc1c) overwrote checksums.toml wholesale, destroying
the [x86_64-unknown-linux-musl] section (14 entries). Detected during eastGate revalidation
as 14/14 MISMATCH on x86_64 depot binaries."""

root_cause = """The harvest/sweep pipeline treats checksums.toml as a single-target file.
It regenerates the file from local build output rather than read-modify-write. When only
one target existed this was fine. With two target sections (x86_64 + aarch64), the second
sweep destroyed the first. This is a data-destructive single-writer assumption."""

recommendation = """1. Read-modify-write: parse existing sections, update only the target being built.
2. Validation gate: verify all known target sections survive before commit.
3. Regression test: harvest A, harvest B, verify A survives."""

classification = "Upstream cascade failure — destructive metadata loss propagated to all gates. P2 (recoverable from local binaries)."

occurrences = ["Wave 105: aarch64 sweep overwrote x86_64 checksums (commit c46cc1c)"]

# ──────────────────────────────────────────────────────────────
# AAR: RECURRING CASCADE CONFLICTS (carried from wave84, RESOLVED Wave 105)
# ──────────────────────────────────────────────────────────────

[aar.cascade_conflicts]
problem = """Recurring ff-only merge conflicts on cascade for plasmidBin (checksums.toml)
and wateringHole (freshness.toml). Occurred on Waves 99, 102, and 103."""

root_cause = """Two files are both locally-generated AND upstream-synced:
  1. checksums.toml — regenerated locally after depot rebuild, also pushed by other gates
  2. freshness.toml — auto-published by cascade on every gate
Multiple gates writing within the same window → ff-only fails."""

recommendation = """Option A (quick fix): Auto-resolve 'theirs' for machine-generated files.
Option B (long-term): Single-writer model — peptidoglycan writes checksums, cascade
initiator writes freshness. cellMembrane implements Option A, evolves toward B."""

occurrences = [
  "Wave 99: plasmidBin checksums.toml",
  "Wave 102: plasmidBin checksums.toml",
  "Wave 103: plasmidBin checksums.toml + wateringHole freshness.toml",
]

# ──────────────────────────────────────────────────────────────
# AAR: GRAPHENEGATE FIRST DEPLOYMENT (Wave 105b)
# ──────────────────────────────────────────────────────────────

[aar.graphenegate_first_deploy]
problem = """grapheneGate NDK cross-compile (aarch64-linux-android) was the assigned task.
bearDog's android_strongbox module has 16 compilation errors for the android target
(missing type imports: KeyGenerationSpec, KeyUsage, AttestationResponse, etc; unimplemented
HSM methods: is_healthy, check, attest_device). This is bearDog team debt, not fixable
from primalSpring."""

root_cause = """The aarch64-linux-android target activates cfg(target_os = "android") code
paths in bearDog's StrongBox HSM module. These paths reference types and methods that exist
only as stubs/skeletons — the actual JNI/Keymaster integration is incomplete. The 16 errors
are in crates/beardog-tunnel/src/tunnel/hsm/android_strongbox/. This blocks the entire
NDK depot since bearDog is a dependency of the Tower composition."""

resolution = """Pivoted to aarch64-unknown-linux-musl which is the correct initial target
for GrapheneOS deployment. musl static binaries run natively on GrapheneOS (no NDK needed).
Built all 13 primals locally on eastGate:
  - ld.lld: symlinked from rust-lld (nestGate + rhizoCrypt required LLD)
  - toolchain: aarch64-musl target added to nestGate's pinned 1.94.1 toolchain
  - binary names: biomeOS needed -p biomeos-unibin, skunkBat needed -p skunk-bat-server
Deployed via deploy_pixel.sh with --beacon-seed. Fixed FAMILY_SEED export missing from
startup script generation. 6/13 primals running (TCP-capable ones). 7 failed due to
Android UDS path restrictions (/run/user/ and /tmp/biomeos/ not accessible under ADB shell)."""

recommendation = """1. bearDog team: complete android_strongbox type definitions and HSM method
   implementations for aarch64-linux-android target.
2. Android UDS adaptation: primals that bind to /run/user/ or /tmp/biomeos/ sockets need
   an Android override to use $HOME-relative paths (e.g., /data/local/tmp/biomeos/).
   This could be a per-primal env var (e.g., BIOMEOS_SOCKET_DIR) or a deploy_pixel.sh
   startup script fix that creates appropriate symlinks.
3. songbird port-conflict: deploy_pixel.sh should kill stale processes before launching
   (pkill by binary path, not just process name)."""

classification = "Design adaptation — musl target validated as correct first step. NDK is a future phase for APK/HSM integration."

occurrences = ["Wave 105b: first grapheneGate deployment — 6/13 primals live on Pixel 8"]

