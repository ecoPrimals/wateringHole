needs_validation = []
gate_playbook = """When gate comes online:
  1. ssh <gate> 'curl -O https://membrane.primals.eco/depot/x86_64-unknown-linux-musl/{primal}' × 13
  2. chmod +x all binaries
  3. Start songbird with federation port, mesh.init to VPS + known LAN peers
  4. Start remaining NUCLEUS from depot
