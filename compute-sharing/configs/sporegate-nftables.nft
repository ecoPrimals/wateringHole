#!/usr/sbin/nft -f
# Composition-deterministic firewall — generated by cellMembrane
# Composition: nucleus
# Gate: sporeGate
# Channel proteins = nftables rules
#
# sporeGate = plasma membrane (K-Derm envelope model)
# WAN: enp1s0 (ATT fiber via BGW320)
# LAN: eno1 (CRS310 L2 backbone → all interior gates)
# Overlay: wg0 (WireGuard mesh → golgiBody 10.13.37.0/24)

flush ruleset

table inet membrane {
    chain input {
        type filter hook input priority 0; policy drop;

        ct state established,related accept
        ct state invalid drop

        iif lo accept

        meta l4proto icmp accept
        meta l4proto icmpv6 accept

        iifname "eno1" accept comment "LAN trusted (plasma membrane interior)"
        udp dport 51820 accept comment "WireGuard mesh overlay"
        iifname "wg0" accept comment "WireGuard overlay input"
        tcp dport 22 accept comment "SSH"
        tcp dport 53 accept comment "knot-dns"
        udp dport 53 accept comment "knot-dns"
        tcp dport 80 accept comment "caddy-acme"
        tcp dport 443 accept comment "caddy"
        tcp dport 3478 accept comment "songbird"
        udp dport 3478 accept comment "songbird"
        tcp dport 9500 accept comment "nestgate"
        tcp dport 21115 accept comment "hbbs-id"
        tcp dport 21116 accept comment "hbbs"
        udp dport 21116 accept comment "hbbs"
        tcp dport 21117 accept comment "hbbr"

        log prefix "nft-drop: " drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept
        iifname "eno1" oifname "enp1s0" accept comment "LAN → WAN"
        iifname "eno1" oifname "eno1" accept comment "LAN → LAN (inter-gate)"
        iifname "wg0" accept comment "WireGuard overlay forward"

        counter drop
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}

table ip membrane-nat {
    chain postrouting {
        type nat hook postrouting priority srcnat;
        oifname "enp1s0" masquerade
    }
}

table ip6 membrane-v6 {
    chain forward {
        type filter hook forward priority 0; policy drop;
        ct state established,related accept
        drop
    }
}
